---
import { projects, appProjects } from '../data/projects';
import MailIcon from './icons/Mail.astro';
import LinkedInIcon from './icons/LinkedIn.astro';
---
<section class="hero wrap" aria-labelledby="intro-title">
  <div class="hero-copy">
    <img class="profile-avatar" src="/images/angello-profile.webp" alt="Angello Nuñez" width="64" height="64" fetchpriority="high" />
    <h1 id="intro-title">Hi, I am Angello</h1>
    <p class="hero-intro">Software engineer living in New Jersey, USA. <strong>Building web and mobile experiences with people in mind.</strong> Founder of Zelandaware, with a background in psychology and a love for bringing ideas to life.</p>
    <div class="hero-actions"><a class="button" href="mailto:angellonzgz@gmail.com"><MailIcon class="size-4" /> Contact me</a><a class="button" href="https://linkedin.com/in/angellonunez" target="_blank" rel="noopener noreferrer"><LinkedInIcon class="size-4" /> LinkedIn</a></div>
  </div>
  <div class="made-by"><p>Things I’ve been building</p><div class="project-pills">{[...projects, ...appProjects].map(project => <a href={`#${project.id}`} class="project-pill"><img src={`/images/${project.image}.webp`} width="36" height="36" alt="" />{project.name}<span aria-hidden="true">↗</span></a>)}</div></div>
</section>
