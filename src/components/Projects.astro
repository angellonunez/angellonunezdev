---
import { projects, appProjects } from '../data/projects';
---
<div class="project-grid">
  {projects.map((project, index) => <article class={`project-card ${project.color}`} id={project.id}>
    <div class="project-art"><span class="project-index">0{index + 1}</span><img src={`/images/${project.image}.webp`} width="220" height="220" loading="lazy" alt={`${project.name} 3D logo`} /><span class="project-category">{project.category}</span></div>
    <div class="project-body"><h3>{project.name} <span aria-hidden="true">↗</span></h3><p class="project-tagline">{project.description}</p><p>{project.detail}</p><a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.link}<span aria-hidden="true">↗</span></a></div>
  </article>)}
</div>
<section class="more-work" aria-labelledby="mobile-apps-title"><h3 class="eyebrow" id="mobile-apps-title">MOBILE APPS · ZELANDAWARE LLC</h3><div class="more-grid">
  {appProjects.map(project => <a id={project.id} href={project.href} target="_blank" rel="noopener noreferrer"><img src={`/images/${project.image}.webp`} width="64" height="64" loading="lazy" alt={`${project.name} 3D logo`} /><div><h3>{project.name}</h3><p>{project.description}</p></div><span aria-hidden="true">↗</span></a>)}
</div></section>
