---
interface Props { title: string; company: string; description: string; link?: string; date: string }
const {title, company, description, link, date} = Astro.props;
---
<div class="timeline-item"><div><h3>{title}</h3><h4>{company}</h4><time>{date}</time></div><div class="timeline-copy"><p>{description}</p>{link && <a href={link} target="_blank" rel="noopener noreferrer">Learn more ↗</a>}</div></div>
