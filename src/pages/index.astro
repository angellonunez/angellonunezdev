---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import AboutMe from '../components/AboutMe.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
---
<Layout title="Angello Nuñez — Software Engineer & Product Builder" description="I’m Angello Nuñez, a software engineer and founder in New Jersey. Explore Peruanify, Hola Grandpa, Shopperpic, Zelandaware, Zenzeito, and Emprezus — things I’m building with curiosity and care.">
  <main id="main">
    <Hero />
    <section class="education-section wrap" id="education"><h2>Education</h2><Education /></section>
    <section class="journey-section wrap" id="experience"><h2>Experience</h2><Experience /></section>
    <section class="work-section wrap" id="projects"><h2>Projects</h2><Projects /></section>
    <AboutMe />
  </main>
</Layout>
